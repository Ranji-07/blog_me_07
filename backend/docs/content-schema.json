{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portfolio.local/schemas/content-schema.json",
  "title": "Portfolio Content Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["about", "projects", "experience", "contact"],
  "properties": {
    "about": {
      "$ref": "#/$defs/aboutSection"
    },
    "projects": {
      "$ref": "#/$defs/projectsSection"
    },
    "experience": {
      "$ref": "#/$defs/experienceSection"
    },
    "contact": {
      "$ref": "#/$defs/contactSection"
    }
  },
  "$defs": {
    "publishState": {
      "type": "string",
      "enum": ["draft", "published", "archived"]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "educationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["degree", "branch", "institution", "duration"],
      "properties": {
        "degree": { "type": "string" },
        "branch": { "type": "string" },
        "institution": { "type": "string" },
        "duration": { "type": "string" }
      }
    },
    "certificationItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "issuer": { "type": "string" },
        "date": { "type": "string" },
        "credential_id": { "type": "string" },
        "credential_url": { "type": "string" }
      }
    },
    "aboutSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "bio", "visible", "status"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "roles": { "$ref": "#/$defs/stringArray" },
        "bio": { "type": "string" },
        "tagline": { "type": "string" },
        "available_for_work": { "type": "boolean" },
        "profile_image": { "type": "string" },
        "resume": { "type": "string" },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projects": { "type": "integer", "minimum": 0 },
            "experience_years": { "type": "integer", "minimum": 0 },
            "technologies": { "type": "integer", "minimum": 0 }
          }
        },
        "tech_stack": { "$ref": "#/$defs/stringArray" },
        "skills": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/stringArray"
          }
        },
        "education": {
          "type": "array",
          "items": { "$ref": "#/$defs/educationItem" }
        },
        "certifications": {
          "type": "array",
          "items": { "$ref": "#/$defs/certificationItem" }
        },
        "visible": { "type": "boolean" },
        "status": { "$ref": "#/$defs/publishState" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "projectItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "slug", "category", "featured", "description", "technologies", "images", "github", "live_demo", "status"],
      "properties": {
        "id": { "type": ["integer", "string"] },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["AI", "Mobile", "Web", "Cloud", "IoT", "DevOps", "Machine Learning", "Open Source"]
        },
        "featured": { "type": "boolean" },
        "short_description": { "type": "string" },
        "description": { "type": "string" },
        "technologies": { "$ref": "#/$defs/stringArray" },
        "features": { "$ref": "#/$defs/stringArray" },
        "images": { "$ref": "#/$defs/stringArray" },
        "github": { "type": "string" },
        "live_demo": { "type": "string" },
        "status": { "$ref": "#/$defs/publishState" }
      }
    },
    "projectsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "visible", "status"],
      "properties": {
        "projects": {
          "type": "array",
          "items": { "$ref": "#/$defs/projectItem" }
        },
        "visible": { "type": "boolean" },
        "status": { "$ref": "#/$defs/publishState" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "timelineItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "company": { "type": "string" },
        "organization": { "type": "string" },
        "date": { "type": "string" },
        "duration": { "type": "string" },
        "description": { "type": "string" },
        "technologies": { "$ref": "#/$defs/stringArray" },
        "links": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "achievementItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "date", "description"],
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "experienceSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work", "internships", "achievements", "opensource", "hackathons", "volunteer", "visible", "status"],
      "properties": {
        "work": {
          "type": "array",
          "items": { "$ref": "#/$defs/timelineItem" }
        },
        "internships": {
          "type": "array",
          "items": { "$ref": "#/$defs/timelineItem" }
        },
        "achievements": {
          "type": "array",
          "items": { "$ref": "#/$defs/achievementItem" }
        },
        "opensource": {
          "type": "array",
          "items": { "$ref": "#/$defs/timelineItem" }
        },
        "hackathons": {
          "type": "array",
          "items": { "$ref": "#/$defs/timelineItem" }
        },
        "volunteer": {
          "type": "array",
          "items": { "$ref": "#/$defs/timelineItem" }
        },
        "visible": { "type": "boolean" },
        "status": { "$ref": "#/$defs/publishState" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "availabilityConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "freelance": { "type": "boolean" },
        "fulltime": { "type": "boolean" },
        "internship": { "type": "boolean" },
        "response_time": { "type": "string" }
      }
    },
    "socialLinks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github": { "type": "string" },
        "linkedin": { "type": "string" },
        "twitter": { "type": "string" },
        "leetcode": { "type": "string" },
        "hackerrank": { "type": "string" },
        "portfolio": { "type": "string" }
      }
    },
    "footerConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "build_year": { "type": "integer", "minimum": 2000 },
        "built_with": { "type": "string" },
        "app_version": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "contactSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "timezone", "social", "availability", "visible", "status"],
      "properties": {
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "timezone": { "type": "string" },
        "social": { "$ref": "#/$defs/socialLinks" },
        "availability": { "$ref": "#/$defs/availabilityConfig" },
        "footer": { "$ref": "#/$defs/footerConfig" },
        "visible": { "type": "boolean" },
        "status": { "$ref": "#/$defs/publishState" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
