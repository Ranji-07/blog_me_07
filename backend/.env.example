# Runtime Configuration
APP_ENV=development

# Database Configuration (PostgreSQL is recommended for production)
DATABASE_URL=sqlite:///./portfolio_dev.db
DATABASE_ECHO=false

# Admin Authentication
ADMIN_EMAIL=ranjithvijay1225@gmail.com
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60

# Email Delivery
EMAIL_DELIVERY_MODE=gmail_api
GMAIL_SENDER_EMAIL=ranjithvijay1225@gmail.com
GMAIL_OAUTH_CLIENT_FILE=.secrets/gmail_client.json
GMAIL_TOKEN_FILE=.secrets/gmail_token.json
CORS_ALLOW_ORIGINS=https://your-frontend-domain.example.com,http://127.0.0.1:58115,http://localhost:58115
TRUST_PROXY_HEADERS=false
CONTACT_RETENTION_DAYS=90
ANALYTICS_RETENTION_DAYS=90

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000
